# Ambientes virtuais (Python virtual environments)
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Variáveis de ambiente e credenciais sensíveis (senhas e tokens)
.env
.env.*
!.env.example

# Credenciais e configurações locais da AWS
.aws/
credentials
config

# Caches e arquivos compilados do Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Caches de testes e ferramentas de análise
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Arquivos temporários e checkpoints de Jupyter / Google Colab
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Arquivos de log e bancos SQLite locais de teste
*.log
*.sqlite3
*.db

# Arquivos temporários do sistema operacional
.DS_Store
Thumbs.db
ehthumbs.db

# Configurações de IDEs (VS Code, JetBrains)
.vscode/
.idea/
